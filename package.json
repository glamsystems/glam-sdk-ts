{
  "name": "@glamsystems/glam-sdk",
  "version": "1.0.13",
  "description": "TypeScript SDK for the GLAM Protocol",
  "main": "./index.cjs.js",
  "module": "./index.esm.js",
  "types": "./index.esm.d.ts",
  "homepage": "https://www.glam.systems",
  "repository": {
    "type": "git",
    "url": "https://github.com/glamsystems/glam-sdk-ts.git"
  },
  "keywords": [
    "glam",
    "solana"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "prepack": "npm run build",
    "pack:dry-run": "npm pack --dry-run --json"
  },
  "files": [
    "README.md",
    "LICENSE",
    "index.cjs.js",
    "index.esm.js",
    "index.cjs.d.ts",
    "index.esm.d.ts",
    "src/**/*.d.ts",
    "target/idl/**/*.json",
    "target/types/**/*.ts",
    "target/types/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@coral-xyz/borsh": "^0.31.1",
    "@glamsystems/sanctum-lst-list": "^0.2.54",
    "@marinade.finance/marinade-ts-sdk": "^5.0.15",
    "@solana/spl-stake-pool": "^1.1.5",
    "@solana/spl-token": "^0.4.9",
    "@solana/spl-token-metadata": "^0.1.4",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "decimal.js": "^10.6.0",
    "fzstd": "^0.1.1",
    "zod": "^3.24.3"
  },
  "engines": {
    "node": ">=20.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "esbuild": "^0.25.2",
    "typescript": "^5.8.3"
  }
}
